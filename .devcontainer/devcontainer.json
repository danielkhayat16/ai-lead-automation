{
  "name": "AI Lead Automation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt -r backend/requirements-dev.txt",
  "postStartCommand": "bash .devcontainer/start-api.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
